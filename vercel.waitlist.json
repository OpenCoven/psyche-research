{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": false},
  "framework": "django",
  "installCommand": "python -m pip install --require-hashes -r requirements.txt",
  "env": {"DJANGO_SETTINGS_MODULE": "config.waitlist_settings", "PILOT_APPROVED": "0"},
  "build": {"env": {"DJANGO_SETTINGS_MODULE": "config.waitlist_settings", "PILOT_APPROVED": "0"}},
  "functions": {
    "config/waitlist_wsgi.py": {
      "maxDuration": 30,
      "excludeFiles": "{archive/**,templates/archive/**,templates/registration/**,static/archive/**,waitlist/tests/**,waitlist/management/**,docs/**,deploy/**,.github/**,.agents/**,var/**,.env*,.venv/**,staticfiles/**}"
    }
  }
}
