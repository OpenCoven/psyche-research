# Candidate only: operator must supply domain, TLS certificate, paths, service user and rotation.
# Do not apply without a reviewed target and explicit deployment approval.
server {
    listen 443 ssl;
    server_name research.example.invalid;
    ssl_certificate /operator/approved/fullchain.pem;
    ssl_certificate_key /operator/approved/privkey.pem;
    client_max_body_size 96k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    # A request must stay within the memory body buffer; disable proxy/body disk spooling.
    client_body_buffer_size 96k;
    access_log off;
    error_log /var/log/nginx/coven-research-error.log crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /static/ {
        alias /operator/approved/release/staticfiles/;
        autoindex off;
        add_header X-Content-Type-Options nosniff;
    }
    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 35s;
    }
}
